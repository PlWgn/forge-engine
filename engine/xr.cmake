# Optional independent OpenXR adapter. Khronos SDK is fetched explicitly, never by CMake.
option(FORGE_WITH_OPENXR "Build OpenXR for Windows PC VR or Android standalone VR" OFF)
add_library(forge_xr STATIC engine/src/xr.cpp)
target_include_directories(forge_xr PUBLIC engine/include vendor vendor/glm)
target_compile_definitions(forge_xr PUBLIC FORGE_WITH_OPENXR=$<BOOL:${FORGE_WITH_OPENXR}>)
if(FORGE_WITH_OPENXR)
  if(NOT WIN32 AND NOT ANDROID)
    message(FATAL_ERROR "Forge OpenXR currently supports Windows/OpenGL and Android/OpenGL ES")
  endif()
  if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/vendor/openxr/CMakeLists.txt")
    message(FATAL_ERROR "Run python tools/dependencies.py --openxr first")
  endif()
  set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_CONFORMANCE_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_API_LAYERS OFF CACHE BOOL "" FORCE)
  set(BUILD_LOADER ON CACHE BOOL "" FORCE)
  set(DYNAMIC_LOADER ON CACHE BOOL "" FORCE)
  add_subdirectory(vendor/openxr EXCLUDE_FROM_ALL)
  target_sources(forge_xr PRIVATE engine/src/xr_openxr.cpp)
  target_include_directories(forge_xr PRIVATE vendor/glfw/include)
  target_link_libraries(forge_xr PUBLIC OpenXR::openxr_loader)
  if(ANDROID)
    target_link_libraries(forge_xr PUBLIC glfw)
  endif()
  if(WIN32)
    target_link_libraries(forge_xr PRIVATE opengl32)
    target_compile_definitions(forge_xr PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    add_custom_command(TARGET forge POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:openxr_loader>" "$<TARGET_FILE_DIR:forge>")
  endif()
endif()
