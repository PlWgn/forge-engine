# Android host for the same Forge sources. A target CPython prefix is supplied explicitly.
if(NOT ANDROID_ABI STREQUAL "arm64-v8a")
  message(FATAL_ERROR "Quest builds require ANDROID_ABI=arm64-v8a")
endif()
set(FORGE_WITH_EDITOR OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_METAL OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_DIRECT3D11 OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_SHADER_TRANSLATOR OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_NETWORKING OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_GNS OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_STEAMWORKS OFF CACHE BOOL "" FORCE)
set(FORGE_WITH_OPENXR ON CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(PYBIND11_NOPYTHON ON CACHE BOOL "" FORCE)
set(FORGE_ANDROID_PYTHON_PREFIX "" CACHE PATH "Extracted official Android aarch64 CPython prefix")
set(FORGE_ANDROID_PYTHON_VERSION "3.14" CACHE STRING "Target CPython major.minor")
set(_python_include "${FORGE_ANDROID_PYTHON_PREFIX}/include/python${FORGE_ANDROID_PYTHON_VERSION}")
set(_python_library "${FORGE_ANDROID_PYTHON_PREFIX}/lib/libpython${FORGE_ANDROID_PYTHON_VERSION}.so")
if(NOT EXISTS "${_python_include}/Python.h" OR NOT EXISTS "${_python_library}")
  message(FATAL_ERROR "Supply an Android arm64 CPython prefix with headers and libpython (not your desktop Python)")
endif()
add_library(Python::Python SHARED IMPORTED GLOBAL)
set_target_properties(Python::Python PROPERTIES IMPORTED_LOCATION "${_python_library}" INTERFACE_INCLUDE_DIRECTORIES "${_python_include}")
add_library(glfw STATIC engine/android/window.cpp)
target_include_directories(glfw PUBLIC vendor/glfw/include engine/include "${ANDROID_NDK}/sources/android/native_app_glue")
target_link_libraries(glfw PUBLIC android log EGL GLESv3 dl)
add_library(OpenGL::GL INTERFACE IMPORTED GLOBAL)
set_target_properties(OpenGL::GL PROPERTIES INTERFACE_LINK_LIBRARIES "EGL;GLESv3")
