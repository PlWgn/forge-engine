{
  "schema_version": 1,
  "project": {
    "name": "Forge — New World",
    "version": "2.5.1",
    "icon": "textures/icon.png"
  },
  "entry_scene": "welcome.json",
  "paths": {
    "graphics": "graphics",
    "modules": "modules",
    "scenes": "scenes",
    "scripts": "scripts",
    "textures": "textures",
    "materials": "materials",
    "models": "models",
    "objects": "objects",
    "audio": "audio",
    "locales": "locales"
  },
  "window": {
    "width": 1280,
    "height": 720,
    "vsync": true,
    "resizable": true,
    "fullscreen": false
  },
  "renderer": {
    "vertex_shader": "default.vert",
    "fragment_shader": "default.frag",
    "font": "font.ttf",
    "fallback_fonts": [],
    "batching": true,
    "gpu_budget_bytes": 134217728
  },
  "logging": {
    "open_on_error": true
  },
  "startup_scripts": [
    "startup.py"
  ],
  "python_paths": [],
  "native_modules": [],
  "save_directory": "saves",
  "build": {
    "description": "Standalone directory or macOS .app with private Python runtime"
  },
  "localization": {
    "default_language": "ru",
    "fallback_language": "en",
    "auto_detect": false,
    "save_selection": true,
    "warn_missing": true,
    "languages": {
      "ru": {
        "name": "Русский",
        "file": "ru.json"
      },
      "en": {
        "name": "English",
        "file": "en.json"
      }
    }
  },
  "storage": {
    "mode": "project",
    "application_id": "org.forge.newworld"
  },
  "asset_budget_bytes": 268435456,
  "audio_settings": {
    "max_voices": 64,
    "channel_limits": {
      "voice": 4,
      "music": 2
    },
    "streaming": "auto",
    "stream_threshold_bytes": 4194304,
    "ducking": [
      {
        "source": "voice",
        "target": "music",
        "gain": 0.3,
        "attack": 0.05,
        "release": 0.5
      }
    ]
  },
  "development": {
    "watch_interval": 0.3
  }
}
